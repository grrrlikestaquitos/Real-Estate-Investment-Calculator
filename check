#!/bin/sh
# The lab's test entry point (lab.conf TEST=./check): runs the full suite and
# writes JUnit XML for the platform's report. Runs the same way in the part's
# image, on the lab's runner, or by hand (DEPLOYING.md, "The test contract").
set -eu
cd "$(dirname "$0")"

results="${LAB_RESULTS:-/tmp/lab-results}"
mkdir -p "$results"

yarn vitest run --reporter=default --reporter=junit --outputFile="$results/junit.xml"
